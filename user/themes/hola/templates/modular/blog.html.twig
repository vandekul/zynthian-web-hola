<section id="{% if page.header.redirect %}{{ page.header.redirect }}{% else %}{{ page.menu|lower|replace({' ': ''}) }}{% endif %}"
        class=" gray-section s-blog {{ page.header.sectionBackground }} target-section">
    {% if not(page.header.noHeader) %}
        <div class="row narrow section-intro has-bottom-sep">
            <div class="col-full">
                <h3>{{ page.header.smallTitle | raw }}</h3>
                <h1>{{ page.title | raw }}</h1>
                <p class="lead">{{ page.header.lead | raw }}</p>
            </div>
        </div>
    {%endif%}
    <div class="row narrow section-intro">
        <div class="row"></div>
        <div class="row">
            {{ wordpress_posts() }}
        </div>
    </div>
    <div class="row narrow section-intro">
        <div class="white-content__scroll">
            {% set localized_url = grav.language.getLanguageURLPrefix() ~ page.header.learnmoreLink %}
            <a href="{{ localized_url }}" class="scroll-link ">
                <span>{{ page.header.learnmoreText }}</span>
            </a>
        </div>
    </div>
</section> <!-- end blog -->
