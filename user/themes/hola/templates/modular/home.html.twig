
<section id="{% if page.header.redirect %}{{ page.header.redirect }}{% else %}{{ page.menu|lower }}{% endif %}"
         class="s-home page-hero target-section home-parallax" data-parallax="scroll" data-position-y="center"
         data-src-desktop="{{ page.media[page.header.background_desktop].url() }}" data-width-desktop="1600" data-height-dektop="1067"
         data-src-mobile="{{ page.media[page.header.background_mobile].url() }}" data-width-mobile="1304" data-height-mobile="1120">

    <div class="overlay" style="opacity:{{ page.header.bannerOpacity }};"></div>
    <div class="shadow-overlay"></div>

    <div class="home-content">

        <div class="row home-content__main">

            <p class="h03">{{ page.title }}</p>

            <h1>{{ content | raw }}</h1>

            <div class="home-content__buttons">
                {% if page.header.button1Text %}
                    <a href="{{ page.header.button1Link }}" class="btn btn--stroke">
                        {{ page.header.button1Text }}
                    </a>
                {% endif %}
                {% if page.header.button2Text %}
                    <a href="{{ page.header.button2Link }}" class="btn btn--stroke">
                        {{ page.header.button2Text }}
                    </a>
                {% endif %}
            </div>

            <div class="home-content__scroll">
                <a href="{{ page.header.button3Link }}" class="scroll-link smoothscroll">
                    <span>{{ page.header.button3Text }}</span>
                </a>
            </div>

        </div>

    </div> <!-- end home-content -->
    {% if page.header.social %}
        <ul class="home-social">
            {% for icon in page.header.social %}
                <li>
                    <a href="{{ icon.socialIconLink }}">
                        <i class="fa {{ icon.socialIconClass }}" aria-hidden="true"></i>
                        <span>{{ icon.socialIconText }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul> <!-- end home-social -->
    {% endif %}

</section> <!-- end s-home -->

<script>
(function() {
    const hero = document.querySelector('.home-parallax');
    if (hero) {
        const isDesktop = window.innerWidth >= 768;

        if (isDesktop) {
            hero.setAttribute('data-image-src', hero.getAttribute('data-src-desktop'));
            hero.setAttribute('data-natural-width', hero.getAttribute('data-width-desktop'));
            hero.setAttribute('data-natural-height', hero.getAttribute('data-height-desktop'));
        } else {
            hero.setAttribute('data-image-src', hero.getAttribute('data-src-mobile'));
            hero.setAttribute('data-natural-width', hero.getAttribute('data-width-mobile'));
            hero.setAttribute('data-natural-height', hero.getAttribute('data-height-mobile'));
        }
    }
})();
</script>
